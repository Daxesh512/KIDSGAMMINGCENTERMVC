<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="keywords" content="Kids" />
    <script type="application/x-javascript"> addEventListener("load", function() { setTimeout(hideURLbar, 0); }, false); function hideURLbar(){ window.scrollTo(0,1); } </script>
    <!-- css -->
    <link href="../Content/css/bootstrap.css" rel="stylesheet" type="text/css" media="all" />
    <link rel="stylesheet" href="../Content/css/flexslider.css" type="text/css" media="screen" property="" />
    <link href="../Content/css/style.css" rel="stylesheet" type="text/css" media="all" />
    <!--// css -->
    <!-- font -->
    <link href='//fonts.googleapis.com/css?family=Josefin+Sans:400,100,100italic,300,300italic,400italic,600,600italic,700,700italic' rel='stylesheet' type='text/css'>
    <link href='//fonts.googleapis.com/css?family=Open+Sans:400,300,300italic,400italic,600,600italic,700,700italic,800,800italic' rel='stylesheet' type='text/css'/>
    <!-- //font -->
    <script type="text/javascript" src="../Content/js/jquery.min.js"></script>
    <script type="text/javascript" src="../Content/js/bootstrap.js"></script>

</head>
<body>
    <div class="header">
        <!-- Navbar -->
        <nav class="navbar navbar-default">
            <div class="container">

                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a href="#"><h1>Kids <img src="../Content/images/c1.png" alt=" " /> Game</h1></a>
                </div>

                <div id="navbar" class="navbar-collapse collapse">
                    <ul class="nav navbar-nav navbar-right">
                        <li class="hover-effect"><a>@Html.ActionLink("Home", "Index", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("About", "About", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("Games", "Games", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("News", "News", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("Contact", "Contact", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("Registration", "Registration", "Home")</a></li>
                        <li class="hover-effect"><a>@Html.ActionLink("Login", "Login", "Home")</a></li>
                    </ul>
                </div>

            </div>
        </nav>
        <!-- //Navbar -->
        <!-- Slider -->
        <div class="slider">
            <ul class="rslides" id="slider">
                <li>
                    <img src="../Content/images/banner1.jpg" alt="" />
                </li>
                <li>
                    <img src="../Content/images/banner2.jpg" alt="" />
                </li>
                <li>
                    <img src="../Content/images/banner3.jpg" alt="" />
                </li>
            </ul>
        </div>
        <!-- //Slider -->

    </div>
    <!-- Banner-Slider-JavaScript -->
    <script src="../Content/js/responsiveslides.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#slider").responsiveSlides({
                auto: true,
                nav: true,
                speed: 800,
                namespace: "callbacks",
                pager: true,
            });
        });
    </script>
    <!-- //Banner-Slider-JavaScript -->
    <!-- //Header -->
    <!-- trend -->
    <div class="trend-w3layouts">
        <div class="container">
            <h2>Trending Games</h2>
            <ul id="flexiselDemo1">
                <li>
                    <div class="trend-grid">
                        <h4>Racing Games</h4>
                        <img src="../Content/images/tg1.jpg" alt=" " class="img-responsive" />
                    </div>
                </li>
                <li>
                    <div class="trend-grid">
                        <h4>3D Games</h4>
                        <img src="../Content/images/tg2.jpg" alt=" " class="img-responsive" />
                    </div>
                </li>
                <li>
                    <div class="trend-grid">
                        <h4>Action Games</h4>
                        <img src="../Content/images/tg3.jpg" alt=" " class="img-responsive" />
                    </div>
                </li>
                <li>
                    <div class="trend-grid">
                        <h4>Toy Games</h4>
                        <img src="../Content/images/tg4.jpg" alt=" " class="img-responsive" />
                    </div>
                </li>
            </ul>
            <script type="text/javascript">
                $(window).load(function () {
                    $("#flexiselDemo1").flexisel({
                        visibleItems: 4,
                        animationSpeed: 1000,
                        autoPlay: true,
                        autoPlaySpeed: 3000,
                        pauseOnHover: true,
                        enableResponsiveBreakpoints: true,
                        responsiveBreakpoints: {
                            portrait: {
                                changePoint: 480,
                                visibleItems: 2
                            },
                            landscape: {
                                changePoint: 640,
                                visibleItems: 3
                            },
                            tablet: {
                                changePoint: 768,
                                visibleItems: 4
                            }
                        }
                    });

                });
            </script>
            <script type="text/javascript" src="../Content/js/jquery.flexisel.js"></script>
        </div>
    </div>

    <div>
        @RenderBody()
    </div>


    <div class="footer">
        <div class="container">
            <div class="col-md-3 footer-left-w3">
                <h4>Contact</h4>
                <ul>
                    <li><span class="glyphicon glyphicon-envelope" aria-hidden="true"></span></li>
                    <li><a href="#"><h6>kindgamming@gmail.com</h6></a></li>
                </ul>
                <ul>
                    <li><span class="glyphicon glyphicon-earphone" aria-hidden="true"></span></li>
                    <li><h6>+91 9966335522</h6></li>
                </ul>
                <ul>
                    <li><span class="glyphicon glyphicon-map-marker" aria-hidden="true"></span></li>
                    <li><h6>Bhavanagr City, INDIA</h6></li>
                </ul>
                <ul>
                    <li><span class="glyphicon glyphicon-phone-alt" aria-hidden="true"></span></li>
                    <li><h6>(+91)9966554422</h6></li>
                </ul>
            </div>
            <div class="col-md-5 footer-middle-w3">
                <h4>Latest Games</h4>
                <div class="col-md-3 img-w3-agile">
                    <a href="#"><img src="../Content/images/ng1.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile">
                    <a href="#"><img src="../Content/images/ng2.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile">
                    <a href="#"><img src="../Content/images/ng3.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile">
                    <a href="#"><img src="../Content/images/ng4.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile footer-middle-wthree">
                    <a href="#"><img src="../Content/images/ng5.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile footer-middle-wthree">
                    <a href="#"><img src="../Content/images/ng6.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile footer-middle-wthree">
                    <a href="#"><img src="../Content/images/ng7.jpg" alt=" " /></a>
                </div>
                <div class="col-md-3 img-w3-agile footer-middle-wthree">
                    <a href="#"><img src="../Content/images/ng8.jpg" alt=" " /></a>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="col-md-4 footer-right-w3">
                <a href="#"><h4>Kids <img src="../Content/images/f1.png" alt=" " /> Game</h4></a>
                <p></p>
                <p class="agileinfo"></p>
            </div>
            <div class="clearfix"></div>
            <div class="copyright">
                <p>&copy; 2023 Kids Video Game. All Rights Reserved | Create By <a href="#" target="_blank">TS Solutions: Jayesh Ahir</a></p>
            </div>
        </div>
    </div>

</body>
</html>
