@model  KIDSGAMMINGCENTERMVC.Models.TblUser
@{
    ViewBag.Title = "Registration";
    Layout = "~/Views/_LayoutPage.cshtml";
}



<center style="background-color:aqua">

    <table align="center" style="height: 393px; width: 462px; background-color: #00FFFF;">
        <tr>
            <th colspan="3"><h1 align="center">Registration here</h1></th>

        </tr>

        <tr>
            <td>Personal Name</td>
            <td>
                <a>@Html.TextBoxFor(m => m.personName)</a>
            </td>
        </tr>
        <tr>
            <td>Username</td>
            <td><a>@Html.TextBoxFor(m => m.userName)</a></td>
        </tr>

        <tr>
            <td>Mobile</td>
            <td>
                <a>@Html.TextBoxFor(m => m.phone)</a>
            </td>
        </tr>

        <tr>
            <td>Password</td>
            <td colspan="2">
                <a>@Html.TextBoxFor(m => m.password)</a>
            </td>
        </tr>
        <tr>
            <td>Confirm Password</td>
            <td colspan="2">
                <a>@Html.TextBoxFor(m => m.password)</a>
            </td>
        </tr>

        <tr>
            <td colspan="3" align="center">
                <input type="Submit" name="submit" id="btnSubmit" value="Submit" />
            </td>
        </tr>

    </table>

</center>

